    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst adminIds = [\n  \"Ue6499ae132e994266ea500b976a3277c\",\n  \"U7fb743a941f0e5574a21b4c5686585e8\"\n];\n\nconst output = [];\n\nfor (const item of items) {\n  const name = item.json[\"取件人\"] || item.json[\"會員名\"] || \"未填寫\";\n  const pickup = item.json[\"取件日\"] || item.json.pickup_date || \"—\";\n  const oid = item.json.order_id || \"—\";\n\n  for (const adminId of adminIds) {\n    output.push({\n      json: {\n        ...item.json,\n        to: adminId,\n        messages: [\n          {\n            type: \"text\",\n            text:\n              \"📦 訂單出貨提醒（倒數 7 天）\\n\" +\n              \"請至後台確認並更新出貨狀態\\n\" +\n              \"取件人：\" + name + \"\\n\" +\n              \"取件日：\" + pickup + \"\\n\" +\n              \"訂單：\" + oid\n          }\n        ]\n      }\n    });\n  }\n}\n\nreturn output;"
      },
