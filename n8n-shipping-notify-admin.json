    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst now = new Date();\nconst today = new Date(now.toLocaleString(\"en-US\", { timeZone: \"Asia/Taipei\" }));\ntoday.setHours(0, 0, 0, 0);\n\nconst isTrue = (v) =>\n  v === true || v === \"TRUE\" || v === \"true\" || v === \"TURE\" || v === \"True\";\n\nconst results = [];\n\nfor (const item of items) {\n  const row = item.json;\n\n  const pickupRaw = row.pickup_date || row[\"取件日\"];\n  if (!pickupRaw) continue;\n\n  let pickup;\n  if (!isNaN(pickupRaw) && String(pickupRaw).trim() !== \"\") {\n    const excelEpoch = new Date(1899, 11, 30);\n    pickup = new Date(excelEpoch.getTime() + Number(pickupRaw) * 86400000);\n  } else {\n    pickup = new Date(pickupRaw);\n  }\n  if (Number.isNaN(pickup.getTime())) continue;\n\n  pickup = new Date(pickup.toLocaleString(\"en-US\", { timeZone: \"Asia/Taipei\" }));\n  pickup.setHours(0, 0, 0, 0);\n\n  const diffDays = Math.round((pickup - today) / (1000 * 60 * 60 * 24));\n\n  const sent7 =\n    isTrue(row.sent_7day) ||\n    isTrue(row.is_sent_7day);\n\n  const sent1 =\n    isTrue(row.sent_1day) ||\n    isTrue(row.is_sent_1day) ||\n    isTrue(row[\"is_sent_1day \"]);\n\n  const sent0 =\n    isTrue(row.sent_0day) ||\n    isTrue(row.is_sent_0day);\n\n  // 前 7 天（既有）\n  if (diffDays === 7 && !sent7) {\n    results.push({ json: { ...row, notify_type: \"7day\", diff_days: 7 } });\n  }\n\n  // 前 1 天（預定配達前一天）\n  if (diffDays === 1 && !sent1) {\n    results.push({ json: { ...row, notify_type: \"1day\", diff_days: 1 } });\n  }\n\n  // 當天（預定配達當天）\n  if (diffDays === 0 && !sent0) {\n    results.push({ json: { ...row, notify_type: \"0day\", diff_days: 0 } });\n  }\n}\n\nreturn results;"
      },
